        //____________________Gegner Schwarm KI____________________________
        //------ Standard-Verhalten ------
        // Diese Werte gelten für alle Gegner, es sei denn, eine abgeleitete Klasse entscheidet sich, andere zu verwenden.
        inline static constexpr float kAIBase_SeekWeight = 2.0f;              // Wie stark der Gegner dem Spieler folgt. Höher = aggressiver.
        inline static constexpr float kAIBase_SeparationWeight = 1.6f;        // Wie stark Gegner sich gegenseitig abstoßen.
        inline static constexpr float kAIBase_PlayerSeparationWeight = 3.0f;  // Wie stark der Spieler den Gegner wegdrückt. Verhindert Überlappung.
        inline static constexpr float kAIBase_DesiredSeparation = 24.0f;      // Der gewünschte Mindestabstand zwischen den Mittelpunkten von zwei Gegnern.
        inline static constexpr float kAIBase_Drag = 0.93f;                   // Die "Reibung" oder Trägheit. Höher = rutscht mehr, niedriger = bremst schneller.

